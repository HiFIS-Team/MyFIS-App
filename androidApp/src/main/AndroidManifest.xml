<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 운동 세션 진행 중 알림 (DESIGN §6.37) — Android 13+ 는 세션을 처음 열 때 묻는다 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 16 승격 알림 — 상태 표시줄 칩 · 잠금화면 위쪽에 올라간다 -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <!-- 운동 세션 음성 가이드 (DESIGN §6.37) — Android 11+ 는 음성 엔진(TTS 서비스)을 찾으려면 조회를 선언해야 한다 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyFIS">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyFIS">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 진행 중 알림의 일시정지 · 다음 — 앱 안에서만 받는다 -->
        <receiver
            android:name=".session.SessionActionReceiver"
            android:exported="false" />
    </application>

</manifest>
